# ========================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO
# Copia este archivo a .env y define tus valores
# ========================================

# Base de datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tickets_user
DB_PASS=tu_password_segura_aqui
DB_NAME=tickets_db

# Inicialización MySQL (si se usa Docker)
MYSQL_ROOT_PASSWORD=password_root_aqui
MYSQL_DATABASE=tickets_db

# Aplicación
APP_NAME="Sistema de Tickets"
ERROR_NOTIFY_EMAIL=admin@tuempresa.com

# Envío de correos mediante Resend API (vía HTTPS REST, sin puertos SMTP)
RESEND_API_KEY=re_123456789_ejemplo
RESEND_FROM=onboarding@resend.dev
MAIL_FROM_NAME="Sistema de Tickets"

# Clave secreta para generación de tokens HMAC y firmas (64 caracteres aleatorios)
SECRET_KEY=genera_una_clave_aleatoria_aqui_de_al_menos_32_o_64_caracteres

# Token para panel de restauración de backups (opcional)
RESTORE_PANEL_TOKEN=

# Notificaciones Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tuempresa.com
